; AZAEL — HERDEIRO DO CAOS
; Projeto inicial Godot 4.x
config_version=5

[application]
config/name="AZAEL — HERDEIRO DO CAOS"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="RPG 3D de fantasia em terceira pessoa."

[autoload]
GameState="*res://scripts/core/game_state.gd"
SaveSystem="*res://scripts/core/save_system.gd"
GraphicsSettings="*res://scripts/core/graphics_settings.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="mobile"
environment/defaults/default_clear_color=Color(0.48, 0.68, 0.86, 1)
rendering_device/fallback_to_opengl3=true

[input]
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
attack={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":70)]
}

save_game={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194336)]
}
load_game={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194340)]
}

dodge={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
block={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194324)]
}
